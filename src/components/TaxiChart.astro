---
interface Props {
  data: unknown[];
  title: string;
  xField: string;
  yField: string;
  /** Axis titles (default: field name with first letter capitalised). */
  xTitle?: string;
  yTitle?: string;
  /** Vega-Lite x type — defaults to "ordinal" (works well for hour-of-day). */
  xType?: "ordinal" | "nominal" | "quantitative" | "temporal";
  /** Bar fill colour. */
  color?: string;
}

const {
  data,
  title,
  xField,
  yField,
  xTitle,
  yTitle,
  xType = "ordinal",
  color = "#eab308",
} = Astro.props;

const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);
const xAxisTitle = xTitle ?? cap(xField);
const yAxisTitle = yTitle ?? cap(yField);
// Sanitise to a valid CSS-selector-safe id: lowercase, only [a-z0-9-].
// Anything else (spaces, %, /, etc.) collapses to a single hyphen so titles
// like "Avg tip %" don't break querySelector.
const chartId =
  "vis-" +
  title
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");
---

<div class="chart-container">
  <h3>{title}</h3>
  <div id={chartId} style="width: 100%; min-height: 300px;"></div>
</div>

<script
  type="application/json"
  id={`data-${chartId}`}
  set:html={JSON.stringify(data)}
/>

<script is:inline src="https://cdn.jsdelivr.net/npm/vega@5"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/vega-lite@5"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/vega-embed@6"></script>

<script define:vars={{ chartId, xField, yField, xType, xAxisTitle, yAxisTitle, color }}>
  const dataElement = document.getElementById(`data-${chartId}`);
  const chartData = JSON.parse(dataElement.textContent);

  const spec = {
    $schema: "https://vega.github.io/schema/vega-lite/v5.json",
    width: "container",
    height: 300,
    data: { values: chartData },
    mark: { type: "bar", tooltip: true },
    encoding: {
      x: { field: xField, type: xType, title: xAxisTitle },
      y: { field: yField, type: "quantitative", title: yAxisTitle },
      color: { value: color },
    },
  };

  vegaEmbed(`#${chartId}`, spec).catch(console.error);
</script>

<style>
  .chart-container {
    background: white;
    padding: 1rem 1.25rem 1.25rem;
    border-radius: 8px;
    border: 1px solid #e5e7eb;
    margin-bottom: 2rem;
  }
  .chart-container h3 {
    margin: 0 0 0.75rem;
    font-size: 1.05rem;
    color: #111827;
  }
</style>
